# Binance API credentials (read-only permissions are sufficient)
API_KEY=your_binance_api_key_here
API_SECRET=your_binance_api_secret_here

# Report start date (required) — format: YYYY-MM-DD
START_DATE=2025-01-01

# Comma-separated list of coins to track (optional, default: USDC,USDT)
TRACKED_COINS=USDC,USDT

# Comma-separated list of Binance IDs to exclude (optional)
EXCLUDED_IDS=